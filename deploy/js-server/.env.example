# Nocturne — js-server shared-edge deployment (noc.whalesound.net)
# ================================================================
# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Postgres passwords are consumed only on FIRST database initialization
# (fresh volume); changing them later does not re-key an existing database.

# -- Images ----------------------------------------------------
NOCTURNE_API_IMAGE=ghcr.io/nightscout/nocturne/nocturne-api:latest
NOCTURNE_WEB_IMAGE=ghcr.io/nightscout/nocturne/nocturne-web:latest

# -- Telemetry (optional) --------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# -- Required --------------------------------------------------
POSTGRES_USERNAME=nocturne

# The subdomain this instance is served on. Unlike the stock bundle (which wants
# the apex only), this shared-edge stack runs Nocturne in single-tenant mode ON a
# subdomain: rpId, WebAuthn origin, tenant resolution and ORIGIN are all derived
# from this exact host. Set it to the full subdomain — NOT the apex.
BASE_DOMAIN=noc.whalesound.net

# Generate each secret with a URI-SAFE generator. Do NOT use plain
# `openssl rand -base64 32`: it can emit '/' '+' '=', and POSTGRES_WEB_PASSWORD
# is interpolated into NOCTURNE_POSTGRES_URI (postgresql://nocturne_web:<pw>@...),
# where those characters corrupt URI parsing. Use one of:
#   openssl rand -hex 32
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
INSTANCE_KEY=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_WEB_PASSWORD=

# -- Optional integrations -------------------------------------
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_SECRET=
# DISCORD_PUBLIC_KEY=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
